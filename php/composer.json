{
    "name": "apiverve/vehiclefueleconomy",
    "description": "Vehicle Fuel Economy returns the EPA ratings of every car and light truck sold in the US since 1984, electric vehicles included. Search by make, model, year and fuel type to get city, highway and combined MPG (or MPGe), electric range, engine, drive and transmission. Paid plans add kWh per 100 miles, charge time at 240V, annual fuel cost, five-year savings, CO2 per mile and the EPA fuel economy, greenhouse gas and smog scores.",
    "version": "1.2.6",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "APIVerve",
            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "vehiclefueleconomy",
        "fuel economy api",
        "mpg api",
        "epa fuel economy",
        "ev range api",
        "electric vehicle api"
    ],
    "homepage": "https://apiverve.com/marketplace/vehiclefueleconomy?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/vehiclefueleconomy",
        "source": "https://github.com/apiverve/vehiclefueleconomy-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Vehiclefueleconomy\\": "src/"
        }
    },
    "autoload-dev": {
